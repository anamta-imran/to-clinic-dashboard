# Neon / Postgres connection string (required for production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# OmniDimension — server-side only (never use NEXT_PUBLIC_*)
OMNIDIMENSION_API_KEY=
OMNIDIMENSION_AGENT_ID=264841
OMNIDIMENSION_WEBHOOK_SECRET=

# Optional: public app URL for webhook configuration notes
# APP_BASE_URL=https://your-domain.example
